    kl:key "strainer_dp" ;
    kl:state "HIGH" .
<http://example.org/digitwin/instance/RC-LOW-TANK-LEVEL> a kl:RootCause ;
    rdfs:label "Low suction tank level" ;
    kl:id "RC-LOW-TANK-LEVEL" ;
    kl:description "Reduced static head (and possible vortexing) lowers NPSHa." ;
    kl:prior "0.6"^^xsd:double .
<http://example.org/digitwin/instance/SYM%3Asuction_tank_level%3ALOW> a kl:Symptom ;
    rdfs:label "Suction tank level LOW" ;
    kl:id "SYM:suction_tank_level:LOW" ;
    kl:key "suction_tank_level" ;
    kl:state "LOW" .
<http://example.org/digitwin/instance/RC-HIGH-FLUID-TEMP> a kl:RootCause ;
    rdfs:label "High fluid temperature" ;
    kl:id "RC-HIGH-FLUID-TEMP" ;
    kl:description "Vapour pressure rises steeply with temperature, consuming the NPSH margin." ;
    kl:prior "0.4"^^xsd:double .
<http://example.org/digitwin/instance/SYM%3Afluid_temperature%3AHIGH> a kl:Symptom ;
    rdfs:label "Pumped fluid temperature HIGH" ;
    kl:id "SYM:fluid_temperature:HIGH" ;
    kl:key "fluid_temperature" ;
    kl:state "HIGH" .
<http://example.org/digitwin/instance/RC-SUCTION-VALVE-THROTTLED> a kl:RootCause ;
    rdfs:label "Partially closed suction valve" ;
    kl:id "RC-SUCTION-VALVE-THROTTLED" ;
    kl:description "A throttled suction valve adds pressure loss after the strainer. Confirmed by elimination: low suction pressure with normal strainer DP, tank level and fluid temperature." ;
    kl:prior "0.3"^^xsd:double .
<http://example.org/digitwin/instance/SYM%3Astrainer_dp%3ANORMAL> a kl:Symptom ;
    rdfs:label "Suction strainer differential pressure NORMAL" ;
    kl:id "SYM:strainer_dp:NORMAL" ;
    kl:key "strainer_dp" ;
    kl:state "NORMAL" .
<http://example.org/digitwin/instance/SYM%3Asuction_tank_level%3ANORMAL> a kl:Symptom ;
    rdfs:label "Suction tank level NORMAL" ;
    kl:id "SYM:suction_tank_level:NORMAL" ;
    kl:key "suction_tank_level" ;
    kl:state "NORMAL" .
<http://example.org/digitwin/instance/SYM%3Afluid_temperature%3ANORMAL> a kl:Symptom ;
    rdfs:label "Pumped fluid temperature NORMAL" ;
    kl:id "SYM:fluid_temperature:NORMAL" ;
    kl:key "fluid_temperature" ;
    kl:state "NORMAL" .
<http://example.org/digitwin/instance/RC-RUNOUT> a kl:RootCause ;
    rdfs:label "Runout operation (low system resistance)" ;
    kl:id "RC-RUNOUT" ;
    kl:description "Flow far beyond rated raises NPSH3, suction losses and absorbed power." ;
    kl:prior "0.5"^^xsd:double .
<http://example.org/digitwin/instance/SYM%3Aflow%3AHIGH> a kl:Symptom ;
    rdfs:label "Discharge flow HIGH" ;
    kl:id "SYM:flow:HIGH" ;
    kl:key "flow" ;
    kl:state "HIGH" .
<http://example.org/digitwin/instance/RC-EMPTY-TANK> a kl:RootCause ;
    rdfs:label "Empty suction tank" ;
    kl:id "RC-EMPTY-TANK" ;
    kl:description "No liquid reaches the pump suction." ;
    kl:prior "0.6"^^xsd:double .
<http://example.org/digitwin/instance/SYM%3Asuction_tank_level%3ALOW_LOW> a kl:Symptom ;
    rdfs:label "Suction tank level LOW_LOW" ;
    kl:id "SYM:suction_tank_level:LOW_LOW" ;
    kl:key "suction_tank_level" ;
    kl:state "LOW_LOW" .
<http://example.org/digitwin/instance/RC-SUCTION-VALVE-CLOSED> a kl:RootCause ;
    rdfs:label "Closed suction valve" ;
    kl:id "RC-SUCTION-VALVE-CLOSED" ;
    kl:description "Suction isolation valve left closed; pump pulls a vacuum on its own casing." ;
    kl:prior "0.4"^^xsd:double .
<http://example.org/digitwin/instance/RC-LOSS-OF-PRIME> a kl:RootCause ;
    rdfs:label "Air ingress / loss of prime" ;
    kl:id "RC-LOSS-OF-PRIME" ;
    kl:description "Air leaking into the suction line or casing displaces the liquid." ;
    kl:prior "0.3"^^xsd:double .
<http://example.org/digitwin/instance/RC-LUBRICATION> a kl:RootCause ;
    rdfs:label "Insufficient or degraded lubrication" ;
    kl:id "RC-LUBRICATION" ;
    kl:description "Low oil level, wrong grade or oxidised lubricant." ;
    kl:prior "0.7"^^xsd:double .
<http://example.org/digitwin/instance/RC-LUBE-CONTAMINATION> a kl:RootCause ;
    rdfs:label "Lubricant contamination" ;
    kl:id "RC-LUBE-CONTAMINATION" ;
    kl:description "Water or particles in the lubricant damage raceways." ;
    kl:prior "0.5"^^xsd:double .
<http://example.org/digitwin/instance/RC-BEARING-FATIGUE> a kl:RootCause ;
    rdfs:label "Bearing fatigue (end of L10 life)" ;
    kl:id "RC-BEARING-FATIGUE" ;
    kl:description "Sub-surface fatigue spalling after the rated number of cycles." ;
    kl:prior "0.3"^^xsd:double .
<http://example.org/digitwin/instance/RC-INSTALL-MISALIGN> a kl:RootCause ;
    rdfs:label "Improper alignment after installation / overhaul" ;
    kl:id "RC-INSTALL-MISALIGN" ;
    kl:description "Shafts not aligned to tolerance when the pump was last installed." ;
    kl:prior "0.6"^^xsd:double .
<http://example.org/digitwin/instance/RC-PIPE-STRAIN> a kl:RootCause ;
    rdfs:label "Pipe strain on pump nozzles" ;
    kl:id "RC-PIPE-STRAIN" ;
    kl:description "Piping forces distort the casing and move the pump shaft." ;
    kl:prior "0.4"^^xsd:double .
<http://example.org/digitwin/instance/RC-SOFT-FOOT> a kl:RootCause ;
    rdfs:label "Soft foot / foundation settlement" ;
    kl:id "RC-SOFT-FOOT" ;
    kl:description "Uneven support lets the machine move when bolts are tightened or under load." ;
    kl:prior "0.3"^^xsd:double .
<http://example.org/digitwin/instance/RC-IMPELLER-FOULING> a kl:RootCause ;
    rdfs:label "Uneven impeller fouling" ;
    kl:id "RC-IMPELLER-FOULING" ;
    kl:description "Non-uniform deposits shift the impeller's mass centre." ;
    kl:prior "0.5"^^xsd:double .
<http://example.org/digitwin/instance/RC-IMPELLER-DAMAGE> a kl:RootCause ;
    rdfs:label "Impeller damage (foreign object / broken vane)" ;
    kl:id "RC-IMPELLER-DAMAGE" ;
    kl:description "Missing or damaged vane material unbalances the rotor and reduces head." ;
    kl:prior "0.3"^^xsd:double .
<http://example.org/digitwin/instance/RC-WEAR-RING-WEAR> a kl:RootCause ;
    rdfs:label "Excessive wear-ring clearance" ;
    kl:id "RC-WEAR-RING-WEAR" ;
    kl:description "Abrasive wear opens the running clearance and increases internal recirculation." ;
    kl:prior "0.6"^^xsd:double .
<http://example.org/digitwin/instance/RC-SEAL-FACE-WEAR> a kl:RootCause ;
    rdfs:label "Seal face wear (end of life)" ;
    kl:id "RC-SEAL-FACE-WEAR" ;
    kl:description "Normal wear of the carbon / silicon-carbide faces." ;
    kl:prior "0.6"^^xsd:double .
<http://example.org/digitwin/instance/RC-ELASTOMER-DEGRADATION> a kl:RootCause ;
    rdfs:label "Seal elastomer degradation" ;
    kl:id "RC-ELASTOMER-DEGRADATION" ;
    kl:description "O-rings harden or swell from temperature or chemical attack." ;
    kl:prior "0.3"^^xsd:double .
<http://example.org/digitwin/instance/RC-DISCHARGE-VALVE-CLOSED> a kl:RootCause ;
    rdfs:label "Closed discharge valve" ;
    kl:id "RC-DISCHARGE-VALVE-CLOSED" ;
    kl:description "Discharge isolation valve closed or not opened after start-up." ;
    kl:prior "0.6"^^xsd:double .
<http://example.org/digitwin/instance/RC-CHECK-VALVE-STUCK> a kl:RootCause ;
    rdfs:label "Check valve stuck closed" ;
    kl:id "RC-CHECK-VALVE-STUCK" ;
    kl:description "The non-return valve disc is jammed shut." ;
    kl:prior "0.3"^^xsd:double .
<http://example.org/digitwin/instance/RC-DISCHARGE-BLOCKED> a kl:RootCause ;
    rdfs:label "Downstream line blockage" ;
    kl:id "RC-DISCHARGE-BLOCKED" ;
    kl:description "Debris or a closed valve further downstream blocks the discharge line." ;
    kl:prior "0.2"^^xsd:double .
<http://example.org/digitwin/instance/RC-MECH-BINDING> a kl:RootCause ;
    rdfs:label "Mechanical binding / rubbing" ;
    kl:id "RC-MECH-BINDING" ;
    kl:description "Rotor rubbing on stationary parts adds friction load." ;
    kl:prior "0.3"^^xsd:double .
<http://example.org/digitwin/instance/RC-SUPPLY-VOLTAGE> a kl:RootCause ;
    rdfs:label "Low or unbalanced supply voltage" ;
    kl:id "RC-SUPPLY-VOLTAGE" ;
    kl:description "For the same load, lower or unbalanced voltage increases motor current." ;
    kl:prior "0.4"^^xsd:double .
<http://example.org/digitwin/instance/RC-DENSE-FLUID> a kl:RootCause ;
    rdfs:label "Fluid denser or more viscous than design" ;
    kl:id "RC-DENSE-FLUID" ;
    kl:description "Absorbed power is proportional to density (and rises with viscosity)." ;
    kl:prior "0.1"^^xsd:double .
