    kl:component_class "ElectricMotor" ;
    kl:parameters "{\"rated_power_kw\": 22.0, \"voltage_v\": 400, \"insulation_class\": \"F\"}" ;
    kl:asset_path "Plant1/Utilities/CoolingWater/P-101/MOTOR" .
<http://example.org/digitwin/instance/P-101.BASEPLATE> a kl:Component ;
    rdfs:label "Baseplate and foundation" ;
    kl:id "P-101.BASEPLATE" ;
    kl:component_class "Baseplate" ;
    kl:asset_path "Plant1/Utilities/CoolingWater/P-101/BASEPLATE" .
<http://example.org/digitwin/instance/PT-101> a kl:Sensor ;
    rdfs:label "Suction pressure" ;
    kl:id "PT-101" ;
    kl:key "suction_pressure" ;
    kl:measurand "pressure" ;
    kl:unit "bar(a)" ;
    kl:lo_lo "0.6"^^xsd:double ;
    kl:lo "0.9"^^xsd:double ;
    kl:hi "2.5"^^xsd:double ;
    kl:normal_value "1.6"^^xsd:double ;
    kl:asset_path "Plant1/Utilities/CoolingWater/P-101/CASING/PT-101" .
<http://example.org/digitwin/instance/ALM%3APT-101-LL> a kl:Alarm ;
    rdfs:label "Suction pressure LOW_LOW" ;
    kl:id "ALM:PT-101-LL" ;
    kl:state "LOW_LOW" ;
    kl:limit "0.6"^^xsd:double ;
    kl:severity "HIGH" ;
    kl:message "Suction pressure LOW_LOW (< 0.6 bar(a))" .
<http://example.org/digitwin/instance/ALM%3APT-101-L> a kl:Alarm ;
    rdfs:label "Suction pressure LOW" ;
    kl:id "ALM:PT-101-L" ;
    kl:state "LOW" ;
    kl:limit "0.9"^^xsd:double ;
    kl:severity "MEDIUM" ;
    kl:message "Suction pressure LOW (< 0.9 bar(a))" .
<http://example.org/digitwin/instance/ALM%3APT-101-H> a kl:Alarm ;
    rdfs:label "Suction pressure HIGH" ;
    kl:id "ALM:PT-101-H" ;
    kl:state "HIGH" ;
    kl:limit "2.5"^^xsd:double ;
    kl:severity "MEDIUM" ;
    kl:message "Suction pressure HIGH (> 2.5 bar(a))" .
<http://example.org/digitwin/instance/PT-102> a kl:Sensor ;
    rdfs:label "Discharge pressure" ;
    kl:id "PT-102" ;
    kl:key "discharge_pressure" ;
    kl:measurand "pressure" ;
    kl:unit "bar(a)" ;
    kl:lo_lo "3.0"^^xsd:double ;
    kl:lo "5.6"^^xsd:double ;
    kl:hi "7.2"^^xsd:double ;
    kl:hi_hi "8.0"^^xsd:double ;
    kl:normal_value "6.5"^^xsd:double ;
    kl:note "NORMAL band = pump curve over the Preferred Operating Region" ;
    kl:asset_path "Plant1/Utilities/CoolingWater/P-101/CASING/PT-102" .
<http://example.org/digitwin/instance/ALM%3APT-102-LL> a kl:Alarm ;
    rdfs:label "Discharge pressure LOW_LOW" ;
    kl:id "ALM:PT-102-LL" ;
    kl:state "LOW_LOW" ;
    kl:limit "3.0"^^xsd:double ;
    kl:severity "HIGH" ;
    kl:message "Discharge pressure LOW_LOW (< 3.0 bar(a))" .
<http://example.org/digitwin/instance/ALM%3APT-102-L> a kl:Alarm ;
    rdfs:label "Discharge pressure LOW" ;
    kl:id "ALM:PT-102-L" ;
    kl:state "LOW" ;
    kl:limit "5.6"^^xsd:double ;
    kl:severity "MEDIUM" ;
    kl:message "Discharge pressure LOW (< 5.6 bar(a))" .
<http://example.org/digitwin/instance/ALM%3APT-102-H> a kl:Alarm ;
    rdfs:label "Discharge pressure HIGH" ;
    kl:id "ALM:PT-102-H" ;
    kl:state "HIGH" ;
    kl:limit "7.2"^^xsd:double ;
    kl:severity "MEDIUM" ;
    kl:message "Discharge pressure HIGH (> 7.2 bar(a))" .
<http://example.org/digitwin/instance/ALM%3APT-102-HH> a kl:Alarm ;
    rdfs:label "Discharge pressure HIGH_HIGH" ;
    kl:id "ALM:PT-102-HH" ;
    kl:state "HIGH_HIGH" ;
    kl:limit "8.0"^^xsd:double ;
    kl:severity "HIGH" ;
    kl:message "Discharge pressure HIGH_HIGH (> 8.0 bar(a))" .
<http://example.org/digitwin/instance/FT-101> a kl:Sensor ;
    rdfs:label "Discharge flow" ;
    kl:id "FT-101" ;
    kl:key "flow" ;
    kl:measurand "volumetric flow" ;
    kl:unit "m3/h" ;
    kl:lo_lo "10.0"^^xsd:double ;
    kl:lo "70.0"^^xsd:double ;
    kl:hi "120.0"^^xsd:double ;
    kl:hi_hi "135.0"^^xsd:double ;
    kl:normal_value "100.0"^^xsd:double ;
    kl:note "LOW/HIGH = outside API 610 Preferred Operating Region" ;
    kl:asset_path "Plant1/Utilities/CoolingWater/P-101/FT-101" .
<http://example.org/digitwin/instance/ALM%3AFT-101-LL> a kl:Alarm ;
    rdfs:label "Discharge flow LOW_LOW" ;
    kl:id "ALM:FT-101-LL" ;
    kl:state "LOW_LOW" ;
    kl:limit "10.0"^^xsd:double ;
