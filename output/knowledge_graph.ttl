@prefix kl: <http://example.org/digitwin/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ---- Ontology (TBox) ----
kl:FunctionalLocation a owl:Class .
kl:Equipment a owl:Class .
kl:Component a owl:Class .
kl:Sensor a owl:Class .
kl:VirtualSensor a owl:Class .
kl:Alarm a owl:Class .
kl:Symptom a owl:Class .
kl:FailureMode a owl:Class .
kl:RootCause a owl:Class .
kl:MaintenanceAction a owl:Class .
kl:contains a owl:ObjectProperty ; rdfs:domain kl:FunctionalLocation .
kl:has_component a owl:ObjectProperty ; rdfs:domain kl:Equipment ; rdfs:range kl:Component .
kl:feeds a owl:ObjectProperty ; rdfs:domain kl:Equipment ; rdfs:range kl:Equipment .
kl:monitors a owl:ObjectProperty ; rdfs:domain kl:Sensor .
kl:derived_from a owl:ObjectProperty ; rdfs:domain kl:VirtualSensor ; rdfs:range kl:Sensor .
kl:triggers a owl:ObjectProperty ; rdfs:range kl:Alarm .
kl:observed_by a owl:ObjectProperty ; rdfs:domain kl:Symptom .
kl:manifests_as a owl:ObjectProperty ; rdfs:domain kl:FailureMode ; rdfs:range kl:Symptom .
kl:occurs_in a owl:ObjectProperty ; rdfs:domain kl:FailureMode .
kl:propagates_to a owl:ObjectProperty ; rdfs:domain kl:FailureMode ; rdfs:range kl:FailureMode .
kl:causes a owl:ObjectProperty ; rdfs:domain kl:RootCause ; rdfs:range kl:FailureMode .
kl:evidenced_by a owl:ObjectProperty ; rdfs:domain kl:RootCause ; rdfs:range kl:Symptom .
kl:located_in a owl:ObjectProperty ; rdfs:domain kl:RootCause .
kl:mitigated_by a owl:ObjectProperty ; rdfs:domain kl:FailureMode ; rdfs:range kl:MaintenanceAction .
kl:remedied_by a owl:ObjectProperty ; rdfs:domain kl:RootCause ; rdfs:range kl:MaintenanceAction .

# ---- Instances (ABox) ----
<http://example.org/digitwin/instance/Plant1> a kl:FunctionalLocation ;
    rdfs:label "Plant 1" ;
    kl:id "Plant1" ;
    kl:level "Site" ;
    kl:asset_path "Plant1" .
<http://example.org/digitwin/instance/Utilities> a kl:FunctionalLocation ;
    rdfs:label "Utilities Area" ;
    kl:id "Utilities" ;
    kl:level "Area" ;
    kl:asset_path "Plant1/Utilities" .
<http://example.org/digitwin/instance/CoolingWater> a kl:FunctionalLocation ;
    rdfs:label "Cooling Water System" ;
    kl:id "CoolingWater" ;
    kl:level "System" ;
    kl:asset_path "Plant1/Utilities/CoolingWater" .
<http://example.org/digitwin/instance/TK-100> a kl:Equipment ;
    rdfs:label "Cooling water suction tank" ;
    kl:id "TK-100" ;
    kl:equipment_class "Tank" ;
    kl:asset_path "Plant1/Utilities/CoolingWater/TK-100" .
<http://example.org/digitwin/instance/STR-100> a kl:Equipment ;
    rdfs:label "Suction strainer" ;
    kl:id "STR-100" ;
    kl:equipment_class "Strainer" ;
    kl:asset_path "Plant1/Utilities/CoolingWater/STR-100" .
<http://example.org/digitwin/instance/HV-101> a kl:Equipment ;
    rdfs:label "Suction isolation valve" ;
    kl:id "HV-101" ;
    kl:equipment_class "ManualValve" ;
    kl:asset_path "Plant1/Utilities/CoolingWater/HV-101" .
<http://example.org/digitwin/instance/P-101> a kl:Equipment ;
    rdfs:label "Cooling water pump" ;
    kl:id "P-101" ;
    kl:equipment_class "CentrifugalPump" ;
    kl:parameters "{\"rated_flow_m3h\": 100.0, \"rated_head_m\": 50.0, \"shutoff_head_m\": 60.0, \"npshr_rated_m\": 4.0, \"speed_rpm\": 2950, \"motor_rated_power_kw\": 22.0, \"motor_full_load_current_a\": 40.0, \"suction_pipe_id_m\": 0.125, \"design_fluid_temp_c\": 30.0, \"fluid\": \"cooling water\", \"por_flow_m3h\": [70.0, 120.0], \"running_current_threshold_a\": 3.0}" ;
    kl:asset_path "Plant1/Utilities/CoolingWater/P-101" .
<http://example.org/digitwin/instance/NRV-102> a kl:Equipment ;
    rdfs:label "Discharge check valve" ;
    kl:id "NRV-102" ;
    kl:equipment_class "CheckValve" ;
    kl:asset_path "Plant1/Utilities/CoolingWater/NRV-102" .
<http://example.org/digitwin/instance/HV-102> a kl:Equipment ;
    rdfs:label "Discharge isolation valve" ;
    kl:id "HV-102" ;
    kl:equipment_class "ManualValve" ;
    kl:asset_path "Plant1/Utilities/CoolingWater/HV-102" .
<http://example.org/digitwin/instance/P-101.CASING> a kl:Component ;
    rdfs:label "Volute casing" ;
    kl:id "P-101.CASING" ;
    kl:component_class "Casing" ;
    kl:asset_path "Plant1/Utilities/CoolingWater/P-101/CASING" .
<http://example.org/digitwin/instance/P-101.IMPELLER> a kl:Component ;
    rdfs:label "Closed impeller" ;
    kl:id "P-101.IMPELLER" ;
    kl:component_class "Impeller" ;
    kl:parameters "{\"vanes\": 6}" ;
    kl:asset_path "Plant1/Utilities/CoolingWater/P-101/IMPELLER" .
<http://example.org/digitwin/instance/P-101.WEAR-RINGS> a kl:Component ;
    rdfs:label "Wear rings" ;
    kl:id "P-101.WEAR-RINGS" ;
    kl:component_class "WearRing" ;
    kl:parameters "{\"design_clearance_mm\": 0.35}" ;
    kl:asset_path "Plant1/Utilities/CoolingWater/P-101/WEAR-RINGS" .
<http://example.org/digitwin/instance/P-101.SHAFT> a kl:Component ;
    rdfs:label "Pump shaft" ;
    kl:id "P-101.SHAFT" ;
    kl:component_class "Shaft" ;
    kl:asset_path "Plant1/Utilities/CoolingWater/P-101/SHAFT" .
<http://example.org/digitwin/instance/P-101.BRG-DE> a kl:Component ;
    rdfs:label "Drive-end bearing" ;
    kl:id "P-101.BRG-DE" ;
    kl:component_class "RollingBearing" ;
    kl:parameters "{\"type\": \"6310 C3\"}" ;
    kl:asset_path "Plant1/Utilities/CoolingWater/P-101/BRG-DE" .
<http://example.org/digitwin/instance/P-101.BRG-NDE> a kl:Component ;
    rdfs:label "Non-drive-end bearing" ;
    kl:id "P-101.BRG-NDE" ;
    kl:component_class "RollingBearing" ;
    kl:parameters "{\"type\": \"7310 BECBM pair\"}" ;
    kl:asset_path "Plant1/Utilities/CoolingWater/P-101/BRG-NDE" .
<http://example.org/digitwin/instance/P-101.SEAL> a kl:Component ;
    rdfs:label "Mechanical seal" ;
    kl:id "P-101.SEAL" ;
    kl:component_class "MechanicalSeal" ;
