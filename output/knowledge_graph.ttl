<http://example.org/digitwin/instance/NPSH-101> a kl:VirtualSensor ;
    rdfs:label "NPSH margin ratio" ;
    kl:id "NPSH-101" ;
    kl:key "npsh_margin" ;
    kl:unit "-" ;
    kl:formula "NPSHa / NPSH3 with NPSHa = (p_s - p_v(T)) / (rho g) + v^2/2g" ;
    kl:lo_lo "1.1"^^xsd:double ;
    kl:lo "1.3"^^xsd:double ;
    kl:note "margin < 1.3 => cavitation risk" ;
    kl:asset_path "Plant1/Utilities/CoolingWater/P-101/NPSH-101" .
<http://example.org/digitwin/instance/ALM%3ANPSH-101-LL> a kl:Alarm ;
    rdfs:label "NPSH margin ratio LOW_LOW" ;
    kl:id "ALM:NPSH-101-LL" ;
    kl:state "LOW_LOW" ;
    kl:limit "1.1"^^xsd:double ;
    kl:severity "HIGH" ;
    kl:message "NPSH margin ratio LOW_LOW (< 1.1)" .
<http://example.org/digitwin/instance/ALM%3ANPSH-101-L> a kl:Alarm ;
    rdfs:label "NPSH margin ratio LOW" ;
    kl:id "ALM:NPSH-101-L" ;
    kl:state "LOW" ;
    kl:limit "1.3"^^xsd:double ;
    kl:severity "MEDIUM" ;
    kl:message "NPSH margin ratio LOW (< 1.3)" .
<http://example.org/digitwin/instance/HEAD-101> a kl:VirtualSensor ;
    rdfs:label "Head ratio vs. OEM curve" ;
    kl:id "HEAD-101" ;
    kl:key "head_ratio" ;
    kl:unit "-" ;
    kl:formula "H_measured / H_curve(Q) with H_measured = (p_d - p_s) / (rho g)" ;
    kl:lo_lo "0.8"^^xsd:double ;
    kl:lo "0.9"^^xsd:double ;
    kl:hi "1.1"^^xsd:double ;
    kl:note "< 0.9 => pump develops less head than its curve" ;
    kl:asset_path "Plant1/Utilities/CoolingWater/P-101/HEAD-101" .
<http://example.org/digitwin/instance/ALM%3AHEAD-101-LL> a kl:Alarm ;
    rdfs:label "Head ratio vs. OEM curve LOW_LOW" ;
    kl:id "ALM:HEAD-101-LL" ;
    kl:state "LOW_LOW" ;
    kl:limit "0.8"^^xsd:double ;
    kl:severity "HIGH" ;
    kl:message "Head ratio vs. OEM curve LOW_LOW (< 0.8)" .
<http://example.org/digitwin/instance/ALM%3AHEAD-101-L> a kl:Alarm ;
    rdfs:label "Head ratio vs. OEM curve LOW" ;
    kl:id "ALM:HEAD-101-L" ;
    kl:state "LOW" ;
    kl:limit "0.9"^^xsd:double ;
    kl:severity "MEDIUM" ;
    kl:message "Head ratio vs. OEM curve LOW (< 0.9)" .
<http://example.org/digitwin/instance/ALM%3AHEAD-101-H> a kl:Alarm ;
    rdfs:label "Head ratio vs. OEM curve HIGH" ;
