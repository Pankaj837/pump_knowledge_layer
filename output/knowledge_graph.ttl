    kl:asset_path "Plant1/Utilities/CoolingWater/P-101/SEAL/LS-101" .
<http://example.org/digitwin/instance/ALM%3ALS-101-H> a kl:Alarm ;
    rdfs:label "Seal leak detector HIGH" ;
    kl:id "ALM:LS-101-H" ;
    kl:state "HIGH" ;
    kl:limit "0.5"^^xsd:double ;
    kl:severity "MEDIUM" ;
    kl:message "Seal leak detector HIGH (> 0.5)" .
<http://example.org/digitwin/instance/LT-100> a kl:Sensor ;
    rdfs:label "Suction tank level" ;
    kl:id "LT-100" ;
    kl:key "suction_tank_level" ;
    kl:measurand "level" ;
    kl:unit "%" ;
    kl:lo_lo "10.0"^^xsd:double ;
    kl:lo "20.0"^^xsd:double ;
    kl:hi "95.0"^^xsd:double ;
    kl:normal_value "70.0"^^xsd:double ;
    kl:asset_path "Plant1/Utilities/CoolingWater/TK-100/LT-100" .
<http://example.org/digitwin/instance/ALM%3ALT-100-LL> a kl:Alarm ;
    rdfs:label "Suction tank level LOW_LOW" ;
    kl:id "ALM:LT-100-LL" ;
    kl:state "LOW_LOW" ;
    kl:limit "10.0"^^xsd:double ;
    kl:severity "HIGH" ;
    kl:message "Suction tank level LOW_LOW (< 10.0 %)" .
<http://example.org/digitwin/instance/ALM%3ALT-100-L> a kl:Alarm ;
    rdfs:label "Suction tank level LOW" ;
    kl:id "ALM:LT-100-L" ;
    kl:state "LOW" ;
    kl:limit "20.0"^^xsd:double ;
    kl:severity "MEDIUM" ;
    kl:message "Suction tank level LOW (< 20.0 %)" .
<http://example.org/digitwin/instance/ALM%3ALT-100-H> a kl:Alarm ;
    rdfs:label "Suction tank level HIGH" ;
    kl:id "ALM:LT-100-H" ;
