    kl:severity "MEDIUM" ;
    kl:message "Suction tank level HIGH (> 95.0 %)" .
<http://example.org/digitwin/instance/PDT-100> a kl:Sensor ;
    rdfs:label "Suction strainer differential pressure" ;
    kl:id "PDT-100" ;
    kl:key "strainer_dp" ;
    kl:measurand "differential pressure" ;
    kl:unit "bar" ;
    kl:hi "0.3"^^xsd:double ;
    kl:hi_hi "0.6"^^xsd:double ;
    kl:normal_value "0.05"^^xsd:double ;
    kl:asset_path "Plant1/Utilities/CoolingWater/STR-100/PDT-100" .
<http://example.org/digitwin/instance/ALM%3APDT-100-H> a kl:Alarm ;
