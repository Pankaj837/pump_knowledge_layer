<http://example.org/digitwin/instance/ALM%3APDT-100-HH> a kl:Alarm ;
    rdfs:label "Suction strainer differential pressure HIGH_HIGH" ;
    kl:id "ALM:PDT-100-HH" ;
    kl:state "HIGH_HIGH" ;
