    kl:message "Discharge flow LOW (< 70.0 m3/h)" .
<http://example.org/digitwin/instance/ALM%3AFT-101-H> a kl:Alarm ;
    rdfs:label "Discharge flow HIGH" ;
    kl:id "ALM:FT-101-H" ;
    kl:state "HIGH" ;
    kl:limit "120.0"^^xsd:double ;
